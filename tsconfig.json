{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "declaration": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "types": ["node", "vitest/globals", "vite/client"]
  },
  "include": ["src", "site", "tests", "tsup.config.ts", "vitest.config.ts", "playwright.config.ts"]
}
